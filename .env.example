# PostgreSQL connection string (required)
DATABASE_URL=postgres://user:password@localhost:5432/onepost
# Firebase Admin SDK service account (required) - Firebase Console > Project
# Settings > Service Accounts > Generate new private key. Copy projectId,
# clientEmail, and privateKey out of the downloaded JSON into these three vars.
FIREBASE_PROJECT_ID=onepost-7d725
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@onepost-7d725.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Port the API server listens on
PORT=8080
# Non-production only: when true (default outside NODE_ENV=production),
# requests without a valid Firebase token fall back to a fixed preview user
# instead of 401ing. Set to "false" to require real sign-in locally too.
PREVIEW_MODE=true
